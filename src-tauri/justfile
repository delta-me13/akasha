# src-tauri 的 crate 级命令。
#
# 为什么放在这里：just 用 **justfile 所在目录**作为配方的工作目录，
# 所以在 src-tauri/ 下 `cargo check` 天然能找到 manifest ——
# 不需要任何 `--manifest-path` 参数（这正是把它们从仓库根搬下来的原因）。
# 附带好处：`cd src-tauri && just check` 单独也能用。
#
# 项目级命令（dev / lint / ready / tools / syscheck）在根 justfile，
# 它对本文件的配方只做**转发**，命令体永远只有一处。

set shell := ["bash", "-uc"]

default:
    @just --list

# ── 编译与检查 ──────────────────────────────────────────────────────────────
#
# ⚠️ 必须显式带 `--workspace`：just 的 cwd 是 `src-tauri/`，而 **cargo 默认只选当前目录所在的包**。
# 少了它，`crates/*` 的类型检查、lint 与单测会被**静默漏掉** —— `just ready` 照样全绿，
# 但那些 crate 根本没被编译过（见 docs/STATUS.md 问题 #20）。
# `cargo fmt --all` 是例外：`--all` 本来就指 workspace 全部成员。

# 类型检查（含 tests / benches），覆盖 workspace 全部成员
check:
    cargo check --workspace --all-targets

# clippy，警告即错误，覆盖 workspace 全部成员
clippy:
    cargo clippy --workspace --all-targets -- -D warnings

fmt:
    cargo fmt --all

fmt-check:
    cargo fmt --all -- --check

# Rust 秒级反馈循环，全程不启动 app —— 改纯逻辑时用这个
watch:
    bacon clippy

# ── 测试 ────────────────────────────────────────────────────────────────────

# 单元测试，覆盖 workspace 全部成员。smoke / integration 在没有 VICTAURI_E2E 时会自行跳过
test:
    cargo nextest run --workspace

# E2E 用例清单（`tests/` 下的目标名）。**新增目标必须加进来** ——
# 否则它会像问题 #36 那样"生成了但没人跑"，而 `just ready` 照样全绿。
# 运行时这条清单由下面的 guard 与 `tests/*.rs` 对账。
#
# ⚠️ **顺序有意义**：清单的顺序就是执行顺序，而它们**共用同一个 app**。
# `tab_close` 只是多开一个标签页再关掉它（不关 app），`window_close` 关掉窗口再显示回来
# （也不关 app），`single_instance` 藏起窗口再让第二个实例把它叫回来（同样不关 app），
# `vault_status` 只读一次文件元数据（什么都不改），
# `vault_unlock` 自己造一个库、解锁、锁定、**跑完删掉**（前置是 `vault_status` 已经读过同一份元数据），
# `ssh_session`（plan 0504）同样自己造库、自己起一台进程内的 SSH 服务端，**跑完删掉** ——
# 它**必须排在 `vault_unlock` 之后**（那两个用例都在动 data 目录里那同一个库文件）。
# `ssh_jump`（plan 0505）是它的经跳板版本：起**两台**服务端，同样自己造库、跑完删掉 ——
# 同样**必须排在 `vault_unlock` 之后**，且在 `ssh_session` 之后（它们用的是同一个库文件）。
# `exit_residue` 会把 app 关掉 —— 所以它排在**另一段**的最后。
#
# ⚠️ **两段，两套配置**（plan 0302 + 0303）：关窗语义由数据目录里的 `config.json` 决定，
# 而它**只在启动时读**。所以：
#   * 第一段（本清单）：没有配置文件 = 默认"收托盘" → `window_close` 有判据；
#   * 第二段（`E2E_TARGETS_EXIT`）：写 `close_behavior=exit` 再起一次 app → `exit_residue`
#     拿到的就是"关窗即退出"这条**可移植**的刺激（不需要托盘宿主，CI 上照样成立）。
E2E_TARGETS := "smoke integration session_channel terminal_render tab_close window_close single_instance vault_status vault_unlock ssh_session ssh_jump ssh_config_import tunnel_state"

# 需要 `close_behavior=exit` 的目标：**只能**在第二段跑（见上）。
E2E_TARGETS_EXIT := "exit_residue"

# **不需要真 app** 的集成测试（显式清单，理由写在各自的文件头）。
#
# 为什么要有这个清单：下面的 guard 会把"tests/ 里没接进 `test-e2e` 的目标"判红
# （问题 #36：生成了但没人跑），但有些集成测试本来就**不碰 app** —— 例如
# `session_watchdog`：它只把 app 二进制以看门狗身份再跑一次（没有窗口、没有 IPC、
# 不碰 Victauri），进 E2E 只会白起一套 Vite + app，而 `just test` 才是它该在的地方。
E2E_NO_APP := "session_watchdog"

# **自己起 app** 的集成测试（同样只登记，不放进 `test-e2e` 的目标清单）。
#
# 为什么要单列：`portable` 验的是"把 bin 所在文件夹搬走"，所以它把二进制**复制**进
# 临时布局、在 A 起一次、搬成 B、在 B 再起一次。它**不能**与 `run_targets` 那套
# 共用一个 app —— 单实例（plan 0304）会让第二份自己退掉。它由下面的 `portable`
# 配方跑（`test-e2e` 的自起分支在第三段调用同一个配方）。
E2E_SELF_APP := "portable"

# E2E：真 app 上的验收（契约 + 交互）。用 cargo test 而非 nextest —— 用例共享一个真 app，必须串行。
#
# **自包含**：已经有 app 在跑（`just dev`）就复用它；没有就自己起一套，跑完收掉。
#   * 前端必须走 Vite dev（1420）：`window.__akashaTerminal` 探针只在 dev 构建里注册，
#     生产构建会把它整段摇掉；
#   * 后端用 debug 构建（`cfg(dev)` → 走 `devUrl`）。
# 为什么要自包含：这个配方不能假设"上一秒有别的进程在跑"（受限环境每次调用一个新
# 命名空间，问题 #33），而"请你自己先起 app"的入口最后就是没人跑（问题 #36）。
# 平台能力差异由用例自己**显式跳过并写明原因**（Wayland 截不了窗口等），
# 多平台覆盖面交给 CI 矩阵（AGENTS.md §12）。
#
# ⚠️ **自己起的 app 才允许被用例关掉**：`exit_residue` 走的就是"关窗 = 真退出"，
# 而它只在 `AKASHA_E2E_OWNS_APP=1`（= 下面这条自起分支）时才真跑，复用别人的 app 时
# 显式跳过并打印原因。`owns_app` 只在自起分支里被设置，别把它挪到外面去。
#
# ⚠️ **自起分支跑两段**（plan 0302 + 0303）：关窗语义由数据目录里的 `config.json` 决定，
# 而它**只在启动时读**，所以两段各起一次 app：
#   1. 第一段（没有配置文件 = 默认"收托盘"）→ `window_close` 在这里有判据；
#   2. 第二段（写 `close_behavior=exit`）→ `exit_residue` 拿到的就是"关窗即退出"
#      这条**可移植**的刺激：不需要托盘宿主，CI（xvfb）上照样成立。
# 那个配置文件属于我们起的这一次运行：开始前备份、跑完还原（见 `restore_config`），
# 别把开发者的便携配置吃掉。
#
# ⚠️ **第三段 = 可搬迁性**（`portable` 配方，plan 0405）：它自己复制二进制、自己起 app，
# 所以**必须**在两段之后、且此时**没有**别的 app 在跑。复用一个开发者的 app 时**跳过**
# 并打印原因（单实例会让那一段起的第二份自己退掉），想验就单独跑 `just portable`。
#
# ⚠️ **两段都要先保证便携数据目录存在**（`mkdir -p "$cfg_dir"`）：便携目录不在时 app 会
# 按 `portable.md` §4 第 2 条退回 **OS 数据目录** —— 于是两段其实跑在不同的数据目录里，
# 而第二段写进去的 `close_behavior` 也就读不到；更糟的是第一段会读到 OS 目录里**上一次**
# 留下的配置（"关窗即退出"），让 `window_close` 莫名其妙地红。
test-e2e:
    @set -uo pipefail; \
    tmp="${TMPDIR:-${TEMP:-/tmp}}"; \
    disc="$tmp/victauri"; \
    vite_url="http://localhost:1420/"; \
    vite_pid=""; app_pid=""; cargo_pid=""; rc=0; \
    touched=0; made_dir=0; saved_cfg=""; \
    cfg_dir="${CARGO_TARGET_DIR:-target}/debug/akasha-data"; \
    cfg_file="$cfg_dir/config.json"; \
    pid_alive() { \
      case "$(uname -s 2>/dev/null || echo unknown)" in \
        MINGW*|MSYS*|CYGWIN*) tasklist //FI "PID eq $1" //NH 2>/dev/null | grep -q "$1" ;; \
        *) kill -0 "$1" 2>/dev/null ;; \
      esac; \
    }; \
    stop() { \
      case "$(uname -s 2>/dev/null || echo unknown)" in \
        MINGW*|MSYS*|CYGWIN*) taskkill //F //PID "$1" >/dev/null 2>&1 || true ;; \
        *) kill "$1" 2>/dev/null || true ;; \
      esac; \
    }; \
    reap() { \
      i=0; \
      while pid_alive "$1" && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done; \
      return 0; \
    }; \
    run_targets() { \
      for t in $1; do \
        echo "── E2E: $t ──"; \
        VICTAURI_E2E=1 cargo test --no-fail-fast --test "$t" -- --test-threads=1 --nocapture || rc=1; \
      done; \
    }; \
    start_app() { \
      cargo build --package akasha || exit 1; \
      before=$(ls "$disc" 2>/dev/null | tr '\n' ' '); \
      echo "→ 起 app（debug 构建，走 devUrl；日志 $1）"; \
      cargo run --quiet --package akasha >"$1" 2>&1 & \
      cargo_pid=$!; \
      app_pid=""; \
      for _ in $(seq 1 120); do \
        for d in "$disc"/*/; do \
          [ -f "${d}port" ] || continue; \
          p=${d%/}; p=${p##*/}; \
          case " $before " in *" $p "*) continue ;; esac; \
          app_pid=$p; break; \
        done; \
        [ -n "$app_pid" ] && break; \
        pid_alive "$cargo_pid" || break; \
        sleep 1; \
      done; \
      if [ -z "$app_pid" ]; then \
        echo "❌ app 没起来（日志：$1）"; tail -n 20 "$1"; exit 1; \
      fi; \
    }; \
    stop_app() { \
      [ -n "$cargo_pid" ] && { stop "$cargo_pid"; wait "$cargo_pid" 2>/dev/null; }; \
      [ -n "$app_pid" ] && { stop "$app_pid"; reap "$app_pid"; }; \
      cargo_pid=""; app_pid=""; \
      return 0; \
    }; \
    restore_config() { \
      [ "$touched" = 1 ] || return 0; \
      if [ -n "$saved_cfg" ]; then \
        cp "$saved_cfg" "$cfg_file"; \
      else \
        rm -f "$cfg_file"; \
        [ "$made_dir" = 1 ] && rmdir "$cfg_dir" 2>/dev/null; \
      fi; \
      return 0; \
    }; \
    cleanup() { \
      stop_app; \
      [ -n "$vite_pid" ] && { stop "$vite_pid"; reap "$vite_pid"; }; \
      restore_config; \
      return 0; \
    }; \
    trap cleanup EXIT; \
    for f in tests/*.rs; do \
      [ -e "$f" ] || continue; \
      t=$(basename "$f" .rs); \
      known=0; \
      case " {{E2E_TARGETS}} {{E2E_TARGETS_EXIT}} " in *" $t "*) known=1 ;; esac; \
      case " {{E2E_NO_APP}} {{E2E_SELF_APP}} " in *" $t "*) known=1 ;; esac; \
      if [ "$known" = 0 ]; then \
        echo "❌ tests/$t.rs 不在 E2E_TARGETS / E2E_TARGETS_EXIT / E2E_NO_APP / E2E_SELF_APP 里 —— 加进其中一处，并写清理由"; rc=1; \
      fi; \
    done; \
    [ "$rc" = 0 ] || exit 1; \
    app_port() { \
      [ -d "$disc" ] || return 1; \
      for d in "$disc"/*/; do \
        [ -f "${d}port" ] || continue; \
        p=${d%/}; p=${p##*/}; \
        case "$p" in ''|*[!0-9]*) continue ;; esac; \
        pid_alive "$p" || continue; \
        port=$(cat "${d}port" 2>/dev/null) || continue; \
        curl -s -o /dev/null -m 2 "http://127.0.0.1:${port}/" || continue; \
        printf '%s' "$port"; return 0; \
      done; \
      return 1; \
    }; \
    if app_port >/dev/null 2>&1; then \
      echo "→ 复用已在运行的 app（不启动、也不收尾；配置是它启动时读的那一份）"; \
      run_targets "{{E2E_TARGETS}} {{E2E_TARGETS_EXIT}}"; \
      echo "→ 跳过第三段（可搬迁性）：那个复用的 app 还在跑，而本段要自己起第二份 ——"; \
      echo "  单实例（plan 0304）会让它自己退掉。想验这条就单独跑 just portable（先把 app 关掉）。"; \
    else \
      if curl -s -o /dev/null -m 2 "$vite_url"; then \
        echo "→ 复用已在运行的 Vite（1420）"; \
      else \
        echo "→ 起 Vite（1420）"; \
        ( cd .. && exec ./node_modules/.bin/vite ) >"$tmp/akasha-e2e-vite.log" 2>&1 & \
        vite_pid=$!; \
        for _ in $(seq 1 60); do curl -s -o /dev/null -m 1 "$vite_url" && break; sleep 1; done; \
        if ! curl -s -o /dev/null -m 2 "$vite_url"; then \
          echo "❌ Vite 起不来（日志：$tmp/akasha-e2e-vite.log）"; exit 1; \
        fi; \
      fi; \
      touched=1; \
      if [ -f "$cfg_file" ]; then \
        saved_cfg="$tmp/akasha-e2e-config.json"; \
        cp "$cfg_file" "$saved_cfg"; \
        echo "→ 便携数据目录里已有配置，先备份（跑完还原）：$cfg_file"; \
      fi; \
      [ -d "$cfg_dir" ] || made_dir=1; \
      mkdir -p "$cfg_dir" || exit 1; \
      rm -f "$cfg_file"; \
      export AKASHA_E2E_OWNS_APP=1; \
      echo "── 第一段：默认配置（关窗 = 收托盘）"; \
      start_app "$tmp/akasha-e2e-app1.log"; \
      run_targets "{{E2E_TARGETS}}"; \
      stop_app; \
      echo "── 第二段：close_behavior=exit（关窗 = 直接退出）"; \
      mkdir -p "$cfg_dir" || exit 1; \
      printf '{"close_behavior":"exit"}\n' > "$cfg_file" || exit 1; \
      start_app "$tmp/akasha-e2e-app2.log"; \
      run_targets "{{E2E_TARGETS_EXIT}}"; \
      stop_app; \
      echo "── 第三段：可搬迁性（把 bin 搬到别处之后，数据还在吗）"; \
      just portable || rc=1; \
    fi; \
    if [ "$rc" != 0 ]; then \
      for l in "$tmp/akasha-e2e-app1.log" "$tmp/akasha-e2e-app2.log" "$tmp/akasha-e2e-app.log"; do \
        if [ -f "$l" ]; then echo "—— app 日志尾部（$l）——"; tail -n 20 "$l"; fi; \
      done; \
    fi; \
    exit $rc

# ── 可搬迁性 ────────────────────────────────────────────────────────────────

# 可搬迁性：把 **bin 所在文件夹整个搬走**，数据还在吗（`docs/portable.md` §5 的五步）。
#
# 判据是 ROADMAP 那一句："移动整个文件夹后重启，原有主机 / 密钥 / 规则都在"——
# **只验证"能开"不算过**（搬家后能开但规则全丢，正是"库里存了绝对路径"的典型症状）。
# 所以用例在 A 起一次（app 自己把库建在便携目录里）→ 收干净 → 灌四套池 → 搬成 B →
# 在 B 再起一次，用 app 自己的命令读回四套池，最后用库函数逐项比对内容。
# 顺带验同一条规则的另一半：便携目录**不可写**时启动即报错（`portable.md` §4 第 3 条）。
#
# ⚠️ **这一段自己起 app**（把二进制复制进临时布局）：被测的是"数据目录从 bin 推导"，
# 而 `test-e2e` 那个 app 跑在 `target/debug/` 里 —— 构建目录搬不动。于是它
# **不能与别的 akasha 同时跑**：单实例（plan 0304）会让第二份自己退掉，症状看起来
# 像"可搬迁性坏了"。这里先查一遍并说清该关掉什么。
# （`just test-e2e` 的自起分支在第三段调用本配方，那时它自己的 app 已经收掉了。）
#
# ⚠️ 用例各自起进程，**必须串行**（`--test-threads=1`）。
portable:
    @set -uo pipefail; \
    tmp="${TMPDIR:-${TEMP:-/tmp}}"; \
    disc="$tmp/victauri"; \
    vite_url="http://localhost:1420/"; \
    vite_pid=""; \
    pid_alive() { \
      case "$(uname -s 2>/dev/null || echo unknown)" in \
        MINGW*|MSYS*|CYGWIN*) tasklist //FI "PID eq $1" //NH 2>/dev/null | grep -q "$1" ;; \
        *) kill -0 "$1" 2>/dev/null ;; \
      esac; \
    }; \
    stop() { \
      case "$(uname -s 2>/dev/null || echo unknown)" in \
        MINGW*|MSYS*|CYGWIN*) taskkill //F //PID "$1" >/dev/null 2>&1 || true ;; \
        *) kill "$1" 2>/dev/null || true ;; \
      esac; \
    }; \
    cleanup() { \
      if [ -n "$vite_pid" ]; then stop "$vite_pid"; wait "$vite_pid" 2>/dev/null; fi; \
      return 0; \
    }; \
    trap cleanup EXIT; \
    if [ -d "$disc" ]; then \
      for d in "$disc"/*/; do \
        [ -f "${d}port" ] || continue; \
        p=${d%/}; p=${p##*/}; \
        pid_alive "$p" || continue; \
        curl -s -o /dev/null -m 2 "http://127.0.0.1:$(cat "${d}port" 2>/dev/null)/" || continue; \
        echo "❌ 已经有一个 akasha 在跑（pid $p）——单实例（plan 0304）会让本配方起的第二份自己退掉，"; \
        echo "   症状看起来像\"可搬迁性坏了\"。先把那个 app 关掉（just dev 起的也是它）再跑。"; \
        exit 1; \
      done; \
    fi; \
    if curl -s -o /dev/null -m 2 "$vite_url"; then \
      echo "→ 复用已在运行的 Vite（1420）"; \
    else \
      echo "→ 起 Vite（1420）"; \
      ( cd .. && exec ./node_modules/.bin/vite ) >"$tmp/akasha-portable-vite.log" 2>&1 & \
      vite_pid=$!; \
      for _ in $(seq 1 60); do curl -s -o /dev/null -m 1 "$vite_url" && break; sleep 1; done; \
      if ! curl -s -o /dev/null -m 2 "$vite_url"; then \
        echo "❌ Vite 起不来（日志：$tmp/akasha-portable-vite.log）"; exit 1; \
      fi; \
    fi; \
    VICTAURI_E2E=1 cargo test --test portable -- --test-threads=1 --nocapture

# ── 性能基线 ────────────────────────────────────────────────────────────────

# 吞吐基线（criterion）。**不是门禁**（AGENTS.md §7）：MB/s 随机器与编译器版本浮动，
# 拿它当通过条件只会得到一条随机红的流水线。用途是**改动前后对比**。
# 基线数字记在 plan 与 docs/STATUS.md。
bench:
    cargo bench --workspace

# ── 依赖门禁 ────────────────────────────────────────────────────────────────
#
# ⚠️ `--workspace` **不能省**，而且必须放在 `check` **之前**（它是顶层参数）。
#
# 为什么：cargo-deny 默认把「manifest 指向的那个包」当作**唯一的图根**（上游原话：
# "that crate will be the sole root of the crate graph, meaning only other workspace
# members that are dependencies of that workspace crate will be included"）。本仓库的
# workspace root 同时是一个真实包（`akasha`），于是**只有 `akasha` 依赖得到的成员**
# 才进图 —— `crates/*` 里尚未被 app 依赖的成员连同它们**独有的整棵子树**都在图外。
#
# 后果不是"少查一点"，而是**静默失效**：`[bans] deny` 里写 `keyring` 也一声不响地不生效，
# 因为它唯一的来路（`akasha-store`）根本不在图里（plan 0402 实测：不加这个参数时
# `bans ok`，加上之后 `bans FAILED … keyring → akasha-store`）。
#
# 这一条同时补上了一个**先于 0402 存在的洞**：`akasha-store` 的 vendored OpenSSL
# （`openssl-src` / `openssl-sys`）此前从未被许可证门禁看过一眼。

# 许可证 + 漏洞 + 来源。advisories 需要联网拉 RustSec 数据库
deny:
    cargo deny --workspace --config deny.toml check

# 同上但跳过需要联网的 advisories，离线可用
deny-offline:
    cargo deny --workspace --config deny.toml check licenses bans sources

# ── 类型边界 ────────────────────────────────────────────────────────────────

# 生成物落点。**Rust 侧是唯一真相源**（AGENTS.md §5），这个文件由生成器写。
BINDINGS := "../src/ipc/bindings.ts"

# Rust command/event → src/ipc/bindings.ts。改过 IPC 就必须跑并提交产物差异
gen-types:
    cargo run --quiet --package akasha --bin gen-types

# 生成物是否与 Rust 侧一致。**不比对的话，"改了 Rust 忘了生成"没有任何门禁会红**，
# 前端就会拿着一份过期的签名继续编译通过（AGENTS.md §5）。已纳入 `just ready`。
gen-types-check:
    @cargo run --quiet --package akasha --bin gen-types
    @if [ -n "$(git status --porcelain -- {{BINDINGS}})" ]; then \
      echo "❌ {{BINDINGS}} 与 Rust 侧不一致 —— 跑 just gen-types 并提交产物差异："; \
      git status --porcelain -- {{BINDINGS}}; \
      exit 1; \
    fi
