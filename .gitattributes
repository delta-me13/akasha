# 统一换行：仓库内一律 LF，检出时不做平台转换（终端类项目对字节敏感）
* text=auto eol=lf

# 明确文本类型
*.rs    text diff=rust
*.toml  text
*.json  text
*.ts    text
*.tsx   text
*.css   text
*.md    text

# 二进制：不做任何转换
*.png   binary
*.ico   binary
*.icns  binary
*.woff  binary
*.woff2 binary

# 生成物：折叠 diff，避免污染 review
pnpm-lock.yaml        linguist-generated=true -diff
src/ipc/bindings.ts   linguist-generated=true
